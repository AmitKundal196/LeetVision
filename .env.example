# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# If MONGO_URI is not provided or fails to connect, the server will fallback to a local JSON file database
MONGO_URI=mongodb://localhost:27017/leetvision

# Security
JWT_SECRET=super_secret_access_key_123_leetvision_ai
JWT_REFRESH_SECRET=super_secret_refresh_key_123_leetvision_ai

# Cache (Optional)
# If REDIS_URL is not provided or fails, the server will automatically use an in-memory Cache manager
REDIS_URL=redis://localhost:6379
